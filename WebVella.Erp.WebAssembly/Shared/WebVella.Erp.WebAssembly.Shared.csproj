<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- SECURITY (OWASP A06:2021 Vulnerable & Outdated Components / CWE-1104): retargeted from end-of-support .NET 7 (EOL 2024-05-14) to .NET 10 LTS to remain on a supported, security-patched runtime and align with the rest of the solution. -->
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>
</Project>
