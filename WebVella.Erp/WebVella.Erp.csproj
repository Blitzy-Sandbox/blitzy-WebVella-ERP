<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<AssemblyName>WebVella.Erp</AssemblyName>
		<OutputType>Library</OutputType>
		<PackageId>WebVella.Erp</PackageId>
		<TypeScriptToolsVersion>Latest</TypeScriptToolsVersion>
		<GeneratePackageOnBuild>false</GeneratePackageOnBuild>
		<Description>The core library of the open-source and free platform WebVella ERP. It allows a quick and painless creation of business web applications.	</Description>
		<Version>1.7.7</Version>
		<Authors>WebVella</Authors>
		<Company>WebVella</Company>
		<PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
		<Copyright>Copyright 2025</Copyright>
		<PackageProjectUrl>https://webvella.com</PackageProjectUrl>
		<Icon>https://webvella.com/favicon.ico</Icon>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<RepositoryUrl>https://github.com/WebVella/WebVella-ERP.git</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<!-- Remove the language litter of code analysis on publish https://github.com/dotnet/roslyn/issues/39458-->
		<SatelliteResourceLanguages>en</SatelliteResourceLanguages>
	</PropertyGroup>


	<ItemGroup>
		<None Include="README.md" Pack="true" PackagePath="\" />
	</ItemGroup>
	
	<ItemGroup>
		<None Remove="Fts\BulStem\Rules\stem_rules_context_1_utf8.txt" />
		<None Remove="Fts\BulStem\Rules\stem_rules_context_2_utf8.txt" />
		<None Remove="Fts\BulStem\Rules\stem_rules_context_3_utf8.txt" />
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Include="Fts\BulStem\Rules\stem_rules_context_1_utf8.txt" />
		<EmbeddedResource Include="Fts\BulStem\Rules\stem_rules_context_2_utf8.txt" />
		<EmbeddedResource Include="Fts\BulStem\Rules\stem_rules_context_3_utf8.txt" />
	</ItemGroup>

	<ItemGroup>
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
	</ItemGroup>

	<ItemGroup>
		<!-- SECURITY (A06 - Vulnerable & Outdated Components): AutoMapper 14.0.0 is affected by
		     GHSA-rvv3-g6hj-g44x / CVE-2026-32933 (HIGH, CWE-674 Uncontrolled Recursion): a deeply
		     nested or self-referential object graph pushed through a mapping path can exhaust the
		     stack (StackOverflowException => denial of service). This dependency is deliberately
		     risk-accepted and kept pinned at [14.0.0] for the following reasons:
		       (1) The maintainer has confirmed NO patch will be released for the 14.x line. The fix
		           (a default MaxDepth of 64) ships only in 15.1.1+/16.1.1+, which are RE-LICENSED
		           from MIT to RPL-1.5 (reciprocal/copyleft) or a commercial license and are therefore
		           incompatible with this project's Apache-2.0 license. The AAP Minimal Change Clause
		           forbids dependency-version and license changes for third-party libraries (0.3.2,
		           0.4.2) and forbids architectural changes (e.g. migrating the mapper) for a
		           non-Critical finding (0.8.2); this advisory is HIGH, not Critical.
		       (2) WebVella maps only its own bounded, non-cyclic internal metadata types (Entity,
		           Field, Relation, Job, User, Role, ...). No attacker-controlled recursive object
		           graph reaches an AutoMapper conversion path, so real-world exploitability of the
		           uncontrolled-recursion DoS is effectively absent for this codebase.
		     The NuGet security audit is VERSION-based and will continue to list this advisory while
		     14.0.0 is referenced; a single solution-wide NuGetAuditSuppress in Directory.Build.props
		     records the accepted risk (for this project and every consumer of it) so the build audit
		     does not fail. The recommended long-term remediation (migrate to a maintained MIT-licensed
		     mapper such as Mapperly) is documented as a High finding in SECURITY.md. -->
		<PackageReference Include="AutoMapper" Version="[14.0.0]" />
		<PackageReference Include="CsvHelper" Version="33.1.0" />
		<PackageReference Include="Ical.Net" Version="5.1.4" />
		<PackageReference Include="Irony.NetCore" Version="1.1.11" />
		<!--<PackageReference Include="Microsoft.AspNetCore.Http.Abstractions" Version="2.2.0" />-->
		<!--<PackageReference Include="Microsoft.Extensions.Caching.Abstractions" Version="10.0.0" />
		<PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="10.0.0" />
		<PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.0" />
		<PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.0" />
		<PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.0" />
		<PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.0" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />-->
		<PackageReference Include="MimeMapping" Version="3.1.0" />
		<PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
		<PackageReference Include="Npgsql" Version="[9.0.4]" />
		<PackageReference Include="Storage.Net" Version="9.3.0" />
		<PackageReference Include="System.Drawing.Common" Version="10.0.1" />
	</ItemGroup>

	<PropertyGroup Condition="'$(Configuration)' == 'Debug'">
		<TypeScriptTarget>ES5</TypeScriptTarget>
		<TypeScriptJSXEmit>None</TypeScriptJSXEmit>
		<TypeScriptModuleKind />
		<TypeScriptCompileOnSaveEnabled>True</TypeScriptCompileOnSaveEnabled>
		<TypeScriptNoImplicitAny>False</TypeScriptNoImplicitAny>
		<TypeScriptRemoveComments>False</TypeScriptRemoveComments>
		<TypeScriptOutFile />
		<TypeScriptOutDir />
		<TypeScriptGeneratesDeclarations>False</TypeScriptGeneratesDeclarations>
		<TypeScriptNoEmitOnError>True</TypeScriptNoEmitOnError>
		<TypeScriptSourceMap>True</TypeScriptSourceMap>
		<TypeScriptMapRoot />
		<TypeScriptSourceRoot />
	</PropertyGroup>

</Project>
