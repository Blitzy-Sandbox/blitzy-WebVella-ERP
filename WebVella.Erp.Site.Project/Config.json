		//via the environment override Settings__DevelopmentMode=true; never commit "true" as the shipped default.
		"DevelopmentMode": "false",
		"EnableBackgroungJobs": "true",
		"EnableFileSystemStorage": "false",
		"FileSystemStorageFolder": "\\\\192.168.10.25\\Share\\erp3-files",
